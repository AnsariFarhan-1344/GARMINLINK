# Google Maps JavaScript API Key
# If not provided, GraminLink automatically falls back to OpenStreetMap (CARTO Voyager tiles)
VITE_GOOGLE_MAPS_API_KEY=

# Gaadi Sahayak Voice Assistant LLM API Key (Vercel / Netlify / Node server-side only; do NOT prefix with VITE_)
# Supports Google Gemini (starts with AIza) or OpenAI (starts with sk-)
LLM_API_KEY=

